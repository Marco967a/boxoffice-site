---
interface Props {
	title: string;
	description?: string;
}
const { title, description = "Classifica e incassi del box office italiano, aggiornati ogni settimana." } = Astro.props;
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/">Italian Box Office Monitoring</a>
			<nav>
				<a href="/">Home</a>
				<a href="/blog">Blog</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<a href="https://github.com/Marco967a/boxoffice-site" target="_blank" rel="noopener">GitHub</a>
			<span aria-hidden="true">·</span>
			<a href="https://www.youtube.com/@SpacchiCinema96" target="_blank" rel="noopener">YouTube</a>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		/* Grigio grafite: superfici e testo */
		--surface-1: #fcfbf8;
		--page: #f5f4ef;
		--text-primary: #211f1c;
		--text-secondary: #54514a;
		--text-muted: #8a8679;
		--gridline: #e2ded2;
		--baseline: #c6c0ae;
		--border: rgba(33, 31, 28, 0.12);
		/* Arancione sporco: colore principale del brand */
		--accent: #bd5b23;
		--accent-strong: #9c4b1b;
		--accent-soft: rgba(189, 91, 35, 0.14);
		/* Verde salvia scuro: colore di contorno/accento secondario */
		--sage: #46542f;
		--sage-strong: #364226;
		--sage-soft: rgba(70, 84, 47, 0.14);
		--series-1: #bd5b23;
		--series-2: #46542f;
	}
	@media (prefers-color-scheme: dark) {
		:root:where(:not([data-theme="light"])) {
			color-scheme: dark;
			--surface-1: #211f1b;
			--page: #16150f;
			--text-primary: #f4f1ea;
			--text-secondary: #c7c2b3;
			--text-muted: #8f8a7a;
			--gridline: #322f28;
			--baseline: #48453b;
			--border: rgba(244, 241, 234, 0.12);
			--accent: #e17a3e;
			--accent-strong: #f0925a;
			--accent-soft: rgba(225, 122, 62, 0.18);
			--sage: #7c9160;
			--sage-strong: #93a878;
			--sage-soft: rgba(124, 145, 96, 0.18);
			--series-1: #e17a3e;
			--series-2: #7c9160;
		}
	}
	:root[data-theme="dark"] {
		color-scheme: dark;
		--surface-1: #211f1b;
		--page: #16150f;
		--text-primary: #f4f1ea;
		--text-secondary: #c7c2b3;
		--text-muted: #8f8a7a;
		--gridline: #322f28;
		--baseline: #48453b;
		--border: rgba(244, 241, 234, 0.12);
		--accent: #e17a3e;
		--accent-strong: #f0925a;
		--accent-soft: rgba(225, 122, 62, 0.18);
		--sage: #7c9160;
		--sage-strong: #93a878;
		--sage-soft: rgba(124, 145, 96, 0.18);
		--series-1: #e17a3e;
		--series-2: #7c9160;
	}

	* { box-sizing: border-box; }
	body {
		margin: 0;
		background: var(--page);
		color: var(--text-primary);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		line-height: 1.5;
	}
	main {
		max-width: 880px;
		margin: 0 auto;
		padding: 24px 16px 64px;
	}
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 880px;
		margin: 0 auto;
		padding: 20px 16px;
		flex-wrap: wrap;
		gap: 12px;
		border-bottom: 2px solid var(--sage-soft);
	}
	.brand {
		font-weight: 600;
		color: var(--text-primary);
		text-decoration: none;
	}
	.brand:hover {
		color: var(--accent);
	}
	.site-header nav {
		display: flex;
		gap: 20px;
	}
	.site-header nav a {
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.95rem;
	}
	.site-header nav a:hover {
		color: var(--accent);
	}
	.site-footer {
		max-width: 880px;
		margin: 0 auto;
		padding: 24px 16px 48px;
		display: flex;
		gap: 10px;
		color: var(--text-muted);
		font-size: 0.9rem;
		border-top: 1px solid var(--border);
	}
	.site-footer a {
		color: var(--sage-strong);
		text-decoration: none;
	}
	.site-footer a:hover {
		color: var(--accent);
	}
</style>
