---
import "@fontsource-variable/space-grotesk";
import SocialLinks from "../components/SocialLinks.astro";

interface Props {
	title: string;
	description?: string;
}
const { title, description = "Classifica e incassi del box office italiano, aggiornati ogni settimana." } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const navItems = [
	{ href: "/", label: "Home" },
	{ href: "/projects/boxoffice", label: "Classifica" },
	{ href: "/blog", label: "Blog" },
];
const isCurrent = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`));

// og:image e canonical richiedono URL assoluti: si attivano solo con `site` in astro.config.mjs
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = Astro.site ? new URL("/og-image.png", Astro.site).href : undefined;
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{canonical && <link rel="canonical" href={canonical.href} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Italian Box Office Monitoring" />
		<meta property="og:locale" content="it_IT" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical.href} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		{ogImage && <meta property="og:image:width" content="1200" />}
		{ogImage && <meta property="og:image:height" content="630" />}
		{ogImage && <meta property="og:image:alt" content="Italian Box Office Monitoring: classifica e incassi del box office italiano" />}
		<!-- Applica il tema scelto prima del primo render, per evitare il flash -->
		<script is:inline>
			try {
				var t = localStorage.getItem("theme");
				if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
			} catch (e) {}
		</script>
	</head>
	<body>
		<header class="site-header">
			<div class="site-header-inner">
				<a class="brand" href="/">Italian Box Office Monitoring</a>
				<div class="header-actions">
					<nav aria-label="Principale">
						{navItems.map((n) => (
							<a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a>
						))}
					</nav>
					<button type="button" class="theme-toggle" aria-label="Passa al tema scuro" title="Passa al tema scuro">
						<svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
						</svg>
						<svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="12" r="4" />
							<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
						</svg>
					</button>
				</div>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<span class="footer-note">Dati aggiornati ogni settimana</span>
			<SocialLinks variant="footer" />
		</footer>

		<script>
			const root = document.documentElement;
			const btn = document.querySelector<HTMLButtonElement>(".theme-toggle");
			const media = window.matchMedia("(prefers-color-scheme: dark)");
			const isDark = () => (root.dataset.theme ? root.dataset.theme === "dark" : media.matches);

			function sync() {
				if (!btn) return;
				const label = isDark() ? "Passa al tema chiaro" : "Passa al tema scuro";
				btn.setAttribute("aria-label", label);
				btn.title = label;
			}

			btn?.addEventListener("click", () => {
				const next = isDark() ? "light" : "dark";
				root.dataset.theme = next;
				try {
					localStorage.setItem("theme", next);
				} catch {}
				sync();
			});
			media.addEventListener("change", sync);
			sync();
		</script>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		/* Grigio grafite: superfici e testo */
		--surface-1: #fcfbf8;
		--page: #f5f4ef;
		--text-primary: #211f1c;
		--text-secondary: #54514a;
		--text-muted: #8a8679;
		--gridline: #e2ded2;
		--baseline: #c6c0ae;
		--border: rgba(33, 31, 28, 0.12);
		/* Arancione sporco: colore principale del brand */
		--accent: #bd5b23;
		--accent-strong: #9c4b1b;
		--accent-soft: rgba(189, 91, 35, 0.14);
		/* Verde salvia scuro: colore di contorno/accento secondario */
		--sage: #46542f;
		--sage-strong: #364226;
		--sage-soft: rgba(70, 84, 47, 0.14);
		/* Rosso YouTube: uguale in tema chiaro e scuro (bianco su #e60000 ≈ 4,8:1) */
		--youtube: #e60000;
		--youtube-strong: #c00000;
		--series-1: #bd5b23;
		--series-2: #46542f;
		--font-display: "Space Grotesk Variable", system-ui, -apple-system, "Segoe UI", sans-serif;
	}
	@media (prefers-color-scheme: dark) {
		:root:where(:not([data-theme="light"])) {
			color-scheme: dark;
			--surface-1: #211f1b;
			--page: #16150f;
			--text-primary: #f4f1ea;
			--text-secondary: #c7c2b3;
			--text-muted: #8f8a7a;
			--gridline: #322f28;
			--baseline: #48453b;
			--border: rgba(244, 241, 234, 0.12);
			--accent: #e17a3e;
			--accent-strong: #f0925a;
			--accent-soft: rgba(225, 122, 62, 0.18);
			--sage: #7c9160;
			--sage-strong: #93a878;
			--sage-soft: rgba(124, 145, 96, 0.18);
			--series-1: #e17a3e;
			--series-2: #7c9160;
		}
	}
	:root[data-theme="dark"] {
		color-scheme: dark;
		--surface-1: #211f1b;
		--page: #16150f;
		--text-primary: #f4f1ea;
		--text-secondary: #c7c2b3;
		--text-muted: #8f8a7a;
		--gridline: #322f28;
		--baseline: #48453b;
		--border: rgba(244, 241, 234, 0.12);
		--accent: #e17a3e;
		--accent-strong: #f0925a;
		--accent-soft: rgba(225, 122, 62, 0.18);
		--sage: #7c9160;
		--sage-strong: #93a878;
		--sage-soft: rgba(124, 145, 96, 0.18);
		--series-1: #e17a3e;
		--series-2: #7c9160;
	}

	* { box-sizing: border-box; }
	body {
		margin: 0;
		background: var(--page);
		color: var(--text-primary);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		line-height: 1.5;
	}
	h1, h2, h3 {
		font-family: var(--font-display);
		letter-spacing: -0.02em;
		line-height: 1.15;
	}
	h1 {
		font-size: clamp(2rem, 5.5vw, 2.9rem);
		font-weight: 700;
	}
	h2 {
		font-size: 1.35rem;
		font-weight: 650;
	}
	main {
		max-width: 880px;
		margin: 0 auto;
		padding: 24px 16px 64px;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: color-mix(in srgb, var(--page) 84%, transparent);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		border-bottom: 2px solid var(--sage-soft);
	}
	.site-header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 8px 12px;
		max-width: 880px;
		margin: 0 auto;
		padding: 12px 16px;
	}
	.brand {
		font-family: var(--font-display);
		font-weight: 650;
		letter-spacing: -0.01em;
		color: var(--text-primary);
		text-decoration: none;
	}
	.brand:hover {
		color: var(--accent);
	}
	.header-actions {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.site-header nav {
		display: flex;
		gap: 4px;
	}
	.site-header nav a {
		position: relative;
		padding: 6px 10px;
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.95rem;
	}
	.site-header nav a:hover {
		color: var(--accent);
	}
	.site-header nav a[aria-current="page"] {
		color: var(--text-primary);
		font-weight: 600;
	}
	.site-header nav a[aria-current="page"]::after {
		content: "";
		position: absolute;
		left: 10px;
		right: 10px;
		bottom: 0;
		height: 2px;
		border-radius: 2px;
		background: var(--accent);
	}
	.site-header a:focus-visible,
	.theme-toggle:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
		border-radius: 6px;
	}
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		padding: 0;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface-1);
		color: var(--text-secondary);
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease;
	}
	.theme-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	/* Mostra la luna in tema chiaro (per passare allo scuro) e il sole in tema scuro */
	.theme-toggle .icon-sun { display: none; }
	:root[data-theme="dark"] .theme-toggle .icon-sun { display: block; }
	:root[data-theme="dark"] .theme-toggle .icon-moon { display: none; }
	@media (prefers-color-scheme: dark) {
		:root:where(:not([data-theme="light"])) .theme-toggle .icon-sun { display: block; }
		:root:where(:not([data-theme="light"])) .theme-toggle .icon-moon { display: none; }
	}

	.site-footer {
		max-width: 880px;
		margin: 0 auto;
		padding: 24px 16px 48px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 14px;
		color: var(--text-muted);
		font-size: 0.9rem;
		border-top: 1px solid var(--border);
	}
</style>
