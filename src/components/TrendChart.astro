---
interface Point {
	week_start: string;
	total_gross: number;
	titles: number;
}
interface Props {
	data: Point[];
	currency: string;
}
const { data, currency } = Astro.props;

const W = 640;
const H = 220;
const PAD_L = 56;
const PAD_R = 16;
const PAD_T = 16;
const PAD_B = 32;
const plotW = W - PAD_L - PAD_R;
const plotH = H - PAD_T - PAD_B;

const values = data.map((d) => d.total_gross);
const max = Math.max(...values, 1);
const min = 0;

const money = new Intl.NumberFormat("it-IT", {
	style: "currency",
	currency,
	maximumFractionDigits: 0,
});
const dateFmt = new Intl.DateTimeFormat("it-IT", { day: "2-digit", month: "short" });

function x(i: number): number {
	if (data.length <= 1) return PAD_L + plotW / 2;
	return PAD_L + (i / (data.length - 1)) * plotW;
}
function y(v: number): number {
	return PAD_T + plotH - ((v - min) / (max - min || 1)) * plotH;
}

const points = data.map((d, i) => ({ ...d, cx: x(i), cy: y(d.total_gross) }));
const linePath = points.map((p, i) => `${i === 0 ? "M" : "L"} ${p.cx} ${p.cy}`).join(" ");
const gridSteps = [0, 0.25, 0.5, 0.75, 1];
---

<figure class="viz-root">
	<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Andamento incassi weekend nelle ultime settimane">
		{gridSteps.map((s) => {
			const gy = PAD_T + plotH - s * plotH;
			return (
				<g>
					<line x1={PAD_L} x2={W - PAD_R} y1={gy} y2={gy} class="gridline" />
					<text x={PAD_L - 8} y={gy + 4} class="tick" text-anchor="end">
						{money.format(max * s)}
					</text>
				</g>
			);
		})}
		<line x1={PAD_L} x2={W - PAD_R} y1={PAD_T + plotH} y2={PAD_T + plotH} class="baseline" />

		{data.length > 1 && <path d={linePath} class="line" fill="none" />}

		{points.map((p) => (
			<g>
				<circle cx={p.cx} cy={p.cy} r="5" class="dot" />
				<title>
					{dateFmt.format(new Date(p.week_start))}: {money.format(p.total_gross)} ({p.titles} titoli)
				</title>
			</g>
		))}

		{points.map((p) => (
			<text x={p.cx} y={H - 8} class="tick" text-anchor="middle">
				{dateFmt.format(new Date(p.week_start))}
			</text>
		))}
	</svg>

	<details class="table-toggle">
		<summary>Vedi i dati in tabella</summary>
		<table>
			<thead>
				<tr>
					<th>Settimana</th>
					<th>Incasso weekend</th>
					<th>Titoli</th>
				</tr>
			</thead>
			<tbody>
				{data.map((d) => (
					<tr>
						<td>{dateFmt.format(new Date(d.week_start))}</td>
						<td>{money.format(d.total_gross)}</td>
						<td>{d.titles}</td>
					</tr>
				))}
			</tbody>
		</table>
	</details>
</figure>

<style>
	.viz-root {
		margin: 0;
		background: var(--surface-1);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 16px;
	}
	svg {
		width: 100%;
		height: auto;
		display: block;
	}
	.gridline {
		stroke: var(--gridline);
		stroke-width: 1;
	}
	.baseline {
		stroke: var(--baseline);
		stroke-width: 1;
	}
	.line {
		stroke: var(--series-1);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.dot {
		fill: var(--series-1);
		stroke: var(--surface-1);
		stroke-width: 2;
	}
	.tick {
		fill: var(--text-muted);
		font-size: 10px;
	}
	.table-toggle {
		margin-top: 12px;
		color: var(--text-secondary);
		font-size: 0.9rem;
	}
	.table-toggle summary {
		cursor: pointer;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		margin-top: 8px;
		font-size: 0.85rem;
	}
	th, td {
		text-align: left;
		padding: 6px 8px;
		border-bottom: 1px solid var(--gridline);
	}
	th {
		color: var(--text-muted);
		font-weight: 500;
	}
</style>
